post_install() {
  cat <<'EOF'
xdg-desktop-portal-omarchy installed.

D-Bus activates the backend. Session routing uses
/usr/share/xdg-desktop-portal/omarchy-portals.conf when
XDG_CURRENT_DESKTOP includes Omarchy (Omarchy:Hyprland).

ScreenCast stays on xdg-desktop-portal-hyprland.
Print stays on xdg-desktop-portal-gtk.
EOF
}

post_upgrade() {
  post_install
}

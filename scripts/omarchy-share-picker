#!/usr/bin/env bash
# XDPH custom_picker_binary: Omarchy-styled share picker via omarchy-shell.
# stdout must match hyprland-share-picker: `[SELECTION]r?/screen:NAME|window:ID|region:OUT@x,y,w,h`
set -euo pipefail
tmp=$(mktemp -d /tmp/omarchy-share-XXXXXX)
reply="$tmp/reply.json"
done="$tmp/done"
preview="$tmp/preview"
mkdir -p "$preview"
allow=false
for a in "$@"; do
  [[ $a == --allow-token ]] && allow=true
done

payload=$(PREVIEW_DIR="$preview" python3 - "$reply" "$done" "$allow" <<'PY'
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed

reply, done, allow = sys.argv[1], sys.argv[2], sys.argv[3] == "true"
preview_dir = os.environ["PREVIEW_DIR"]


def run_json(args):
    try:
        out = subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL)
        return json.loads(out)
    except Exception:
        return []


def parse_windows(env: str):
    # xdph: id[HC>]class[HT>]title[HE>]address[HA>]
    # address is hyprland toplevel mapping (often decimal), or 0 if unmapped
    out = []
    rolling = env or ""
    while rolling:
        id_sep = rolling.find("[HC>]")
        class_sep = rolling.find("[HT>]")
        title_sep = rolling.find("[HE>]")
        addr_sep = rolling.find("[HA>]")
        if min(id_sep, class_sep, title_sep, addr_sep) < 0:
            break
        out.append(
            {
                "id": rolling[:id_sep],
                "class": rolling[id_sep + 5 : class_sep],
                "title": rolling[class_sep + 5 : title_sep],
                "address": rolling[title_sep + 5 : addr_sep],
            }
        )
        rolling = rolling[addr_sep + 5 :]
    return out


def parse_addr(addr: str):
    """Normalize hyprctl 0x… / xdph decimal address to int, or None."""
    a = (addr or "").strip().lower()
    if not a or a == "0":
        return None
    try:
        if a.startswith("0x"):
            return int(a, 16)
        if all(ch in "0123456789" for ch in a):
            return int(a, 10)
        return int(a, 16)
    except ValueError:
        return None


def client_by_addr(clients):
    by = {}
    for c in clients:
        key = parse_addr(str(c.get("address") or ""))
        if key is not None:
            by[key] = c
    return by


def find_client(w, by_addr, clients):
    key = parse_addr(str(w.get("address") or ""))
    if key is not None and key in by_addr:
        return by_addr[key]

    klass = str(w.get("class") or "")
    title = str(w.get("title") or "")
    # xdph sanitizes quotes/$/backticks; hyprctl titles are raw — compare loosely
    exact = []
    for c in clients:
        if str(c.get("class") or "") != klass:
            continue
        ct = str(c.get("title") or "")
        if ct == title or _soft_title(ct) == _soft_title(title):
            exact.append(c)
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        return exact[0]

    same_class = [c for c in clients if str(c.get("class") or "") == klass]
    if len(same_class) == 1:
        return same_class[0]
    return None


def _soft_title(s: str) -> str:
    return re.sub(r"[\"'`$]", " ", s).strip()


def safe_name(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]+", "_", value)[:96] or "x"


def capture_bin():
    """Resolve omarchy-portal-capture (hyprland_toplevel_export helper)."""
    env = os.environ.get("OMARCHY_PORTAL_CAPTURE")
    if env and os.path.isfile(env) and os.access(env, os.X_OK):
        return env
    here = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.expanduser("~/.local/libexec/omarchy-portal-capture"),
        os.path.join(here, "..", "target", "release", "omarchy-portal-capture"),
        os.path.join(here, "..", "target", "debug", "omarchy-portal-capture"),
        "omarchy-portal-capture",
    ]
    for c in candidates:
        if c == "omarchy-portal-capture":
            from shutil import which

            w = which(c)
            if w:
                return w
            continue
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def logical_size(mon):
    scale = float(mon.get("scale") or 1) or 1.0
    width = int(mon.get("width") or 0)
    height = int(mon.get("height") or 0)
    tw, th = int(width / scale), int(height / scale)
    if int(mon.get("transform") or 0) in (1, 3):
        return th, tw
    return tw, th


def screen_label(mon, name):
    """KDE-style display text: manufacturer model (NAME), else NAME."""
    parts = []
    make = str(mon.get("make") or mon.get("manufacturer") or "").strip()
    model = str(mon.get("model") or "").strip()
    desc = str(mon.get("description") or "").strip()
    if make:
        parts.append(make)
        if model:
            parts.append(model)
        parts.append(f"({name})")
        return " ".join(parts)
    if desc and desc != name:
        return f"{desc} ({name})"
    return name


def rects_intersect(ax, ay, aw, ah, bx, by, bw, bh):
    return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by


def build_screens(monitors):
    screens = []
    for mon in monitors:
        name = str(mon.get("name") or "")
        if not name:
            continue
        lw, lh = logical_size(mon)
        path = os.path.join(preview_dir, f"screen-{safe_name(name)}.png")
        screens.append(
            {
                "name": name,
                "label": screen_label(mon, name),
                "value": f"screen:{name}",
                "preview": path,
                "x": int(mon.get("x") or 0),
                "y": int(mon.get("y") or 0),
                "width": lw,
                "height": lh,
                "synthetic": False,
                "icon": "video-display",
                "tasks": [],
            }
        )
    return screens


def build_synthetics():
    # KDE OutputsModel RegionIncluded — card without preview in Displays section
    return [
        {
            "name": "Region",
            "label": "Share region",
            "value": "REGION_PICK",
            "preview": "",
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0,
            "synthetic": True,
            "icon": "select-rectangular",
            "tasks": [],
        }
    ]


def build_windows(raw_windows, clients):
    by_addr = client_by_addr(clients)
    out = []
    for w in raw_windows:
        c = find_client(w, by_addr, clients)
        title = str((c or {}).get("title") or w.get("title") or "")
        klass = str((c or {}).get("class") or w.get("class") or "")
        if title == "Omarchy Portal":
            continue
        if c is not None and (c.get("mapped") is False or c.get("hidden") is True):
            continue
        # Prefer hyprctl "0x…" address string. Never put the numeric handle in
        # JSON as a number — JS loses precision above 2^53 and ScreencopyView
        # matching against Hyprland.toplevels fails.
        addr_str = ""
        if c is not None:
            addr_str = str(c.get("address") or "").strip()
        if not addr_str:
            addr_str = str(w.get("address") or "").strip()
        handle = parse_addr(addr_str)
        if handle is not None and not addr_str.lower().startswith("0x"):
            addr_str = hex(handle)
        wid = str(w.get("id") or "")
        label = klass or "Window"
        if title:
            label = f"{klass}: {title}" if klass else title
        at = (c or {}).get("at") or [0, 0]
        size = (c or {}).get("size") or [0, 0]
        try:
            wx, wy = int(at[0]), int(at[1])
            ww, wh = int(size[0]), int(size[1])
        except (TypeError, ValueError, IndexError):
            wx = wy = ww = wh = 0
        path = os.path.join(preview_dir, f"win-{safe_name(wid)}.png")
        out.append(
            {
                "id": wid,
                "className": klass,
                "title": title,
                "address": addr_str,
                "handle": addr_str,
                "label": label,
                "value": f"window:{wid}",
                "preview": path,
                "icon": klass or "application-x-executable",
                "x": wx,
                "y": wy,
                "width": ww,
                "height": wh,
                "monitor": (c or {}).get("monitor"),
            }
        )
    return out


def client_tasks_for_screens(screens, clients):
    """KDE TasksModel-on-output: up to 4 window icons per display (+remainder).

    Uses hyprctl clients (all mapped windows), not only XDPH shareable list.
    """
    for s in screens:
        if s.get("synthetic"):
            continue
        sx, sy, sw, sh = s["x"], s["y"], s["width"], s["height"]
        hits = []
        for c in clients:
            if c.get("mapped") is False or c.get("hidden") is True:
                continue
            title = str(c.get("title") or "")
            if title == "Omarchy Portal":
                continue
            at = c.get("at") or [0, 0]
            size = c.get("size") or [0, 0]
            try:
                wx, wy = int(at[0]), int(at[1])
                ww, wh = int(size[0]), int(size[1])
            except (TypeError, ValueError, IndexError):
                continue
            if not rects_intersect(sx, sy, sw, sh, wx, wy, ww, wh):
                continue
            klass = str(c.get("class") or "")
            label = f"{klass}: {title}" if klass and title else (klass or title or "Window")
            hits.append({"icon": klass or "application-x-executable", "label": label})
        s["tasks"] = hits[:4]
        s["taskCount"] = len(hits)
        s["taskOverflow"] = max(0, len(hits) - 4)


def capture(screens, windows):
    bin_path = capture_bin()
    jobs = []
    for s in screens:
        jobs.append(("screen", s["name"], s["preview"], None))
    for w in windows:
        handle = w.get("handle")
        if handle:
            jobs.append(("window", handle, w["preview"], None))

    def one(job):
        kind, key, path, _ = job
        try:
            if kind == "screen":
                subprocess.run(
                    ["grim", "-o", str(key), path],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            elif bin_path:
                # hyprland_toplevel_export_v1 via helper (correct for overlapping windows)
                subprocess.run(
                    [bin_path, "window", hex(int(key)), path, "--size", "480"],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
        except Exception:
            pass
        return path

    if not jobs:
        return
    workers = min(4, len(jobs))
    with ThreadPoolExecutor(max_workers=workers) as pool:
        list(as_completed([pool.submit(one, j) for j in jobs]))

monitors = run_json(["hyprctl", "-j", "monitors"])
clients = run_json(["hyprctl", "-j", "clients"])
screens = build_screens(monitors if isinstance(monitors, list) else [])
windows = build_windows(
    parse_windows(os.environ.get("XDPH_WINDOW_SHARING_LIST", "")),
    clients if isinstance(clients, list) else [],
)
client_list = clients if isinstance(clients, list) else []
client_tasks_for_screens(screens, client_list)
# Live previews are ScreencopyView in QML — do not block on grim/PNG here.
outputs = screens + build_synthetics()

print(
    json.dumps(
        {
            "kind": "Share",
            "request": {},
            "extra": {
                "allowToken": allow,
                "previewDir": preview_dir,
                "screens": outputs,
                "windows": windows,
            },
            "replyFile": reply,
            "doneFile": done,
        }
    )
)
PY
)

cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT

if ! omarchy-shell shell summon omarchy-portal "$payload" >/dev/null; then
  echo "[SELECTION]/"
  exit 1
fi

selection=""
allow_token="$allow"
for _ in $(seq 1 6000); do
  if [[ -f $done ]]; then
    mapfile -t _reply_lines < <(python3 - "$reply" "$allow" <<'PY'
import json, sys
path, default_allow = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path))
except Exception:
    data = {}
selection = data.get("selection") or "[SELECTION]/"
allow = data.get("allowToken")
if allow is None:
    allow = default_allow == "true"
else:
    allow = bool(allow)
# two lines: selection, then allow true/false
print(str(selection).replace("\n", " "))
print("true" if allow else "false")
PY
)
    selection="${_reply_lines[0]:-}"
    allow_token="${_reply_lines[1]:-$allow}"
    break
  fi
  sleep 0.05
done

if [[ -z ${selection} ]]; then
  echo "[SELECTION]/"
  exit 1
fi

token=""
[[ $allow_token == true ]] && token=r

if [[ $selection == REGION_PICK ]]; then
  # Dialog must close before freeze/slurp; omarchy-capture-region freezes the screen.
  sleep 0.2
  target=$(omarchy-capture-region smart --match-monitor 2>/dev/null || true)
  if [[ -z $target ]]; then
    echo "[SELECTION]/"
    exit 1
  fi
  if [[ $target == monitor:* ]]; then
    echo "[SELECTION]${token}/screen:${target#monitor:}"
    exit 0
  fi
  region=$(python3 - "$target" <<'PY'
import json, re, subprocess, sys

geo = sys.argv[1].strip()
m = re.match(r"^(-?\d+),(-?\d+)\s+(\d+)x(\d+)$", geo)
if not m:
    raise SystemExit(0)
x, y, w, h = map(int, m.groups())
try:
    monitors = json.loads(subprocess.check_output(["hyprctl", "-j", "monitors"], text=True))
except Exception:
    monitors = []

def logical_size(mon):
    scale = float(mon.get("scale") or 1) or 1.0
    width = int(mon.get("width") or 0)
    height = int(mon.get("height") or 0)
    tw, th = int(width / scale), int(height / scale)
    if int(mon.get("transform") or 0) in (1, 3):
        return th, tw
    return tw, th

cx, cy = x + w // 2, y + h // 2
chosen = None
for mon in monitors:
    mx = int(mon.get("x") or 0)
    my = int(mon.get("y") or 0)
    mw, mh = logical_size(mon)
    if mx <= cx < mx + mw and my <= cy < my + mh:
        chosen = mon
        break
if chosen is None and monitors:
    chosen = monitors[0]
if not chosen:
    raise SystemExit(0)
mx = int(chosen.get("x") or 0)
my = int(chosen.get("y") or 0)
name = str(chosen.get("name") or "")
print(f"{name}@{x - mx},{y - my},{w},{h}")
PY
)
  if [[ -z $region ]]; then
    echo "[SELECTION]/"
    exit 1
  fi
  echo "[SELECTION]${token}/region:${region}"
  exit 0
fi

echo "$selection"
exit 0
